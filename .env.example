# ============================================================
# VeADK AIOps Agent 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# --- 大模型 API ---
# 必填：LLM API Key（支持 OpenAI 兼容接口）
VEADK_LLM_API_KEY=sk-b00b268fd2e24fc69c64609ddf8f7ca4
# API 地址（DeepSeek 兼容 OpenAI 接口）
VEADK_LLM_BASE_URL=https://api.deepseek.com
# 模型名称（deepseek-v4-pro: 最强 / deepseek-v4-flash: 更快）
VEADK_LLM_MODEL=deepseek-v4-pro
# 最大输出 Token 数
VEADK_LLM_MAX_TOKENS=4096
# 温度（0.0-1.0，越低越确定性）
VEADK_LLM_TEMPERATURE=0.1

# --- Prometheus ---
# Prometheus 查询地址（成员 A 电脑的 Minikube 暴露地址）
VEADK_PROMETHEUS_URL=http://localhost:9090
# 查询超时（秒）
VEADK_PROMETHEUS_TIMEOUT=10

# --- recovery-gateway ---
# 自愈网关 API 地址
VEADK_RECOVERY_GATEWAY_URL=http://localhost:8080
# 自愈网关认证 Token（需与 K8s Secret 中配置的一致）
VEADK_RECOVERY_AUTH_TOKEN=replace-with-strong-agent-token

# --- Kubernetes ---
# 默认命名空间
VEADK_K8S_NAMESPACE=sock-shop

# --- Webhook 服务器 ---
# 监听端口
VEADK_WEBHOOK_PORT=5000

# --- Agent 行为参数 ---
# 单次诊断最大工具调用轮数
VEADK_MAX_TOOL_CALLS=5
# CPU 告警阈值（轮询模式）
VEADK_CPU_THRESHOLD=0.5
# 巡检间隔（秒）
VEADK_PATROL_INTERVAL=10
# 同一告警冷却期（秒）
VEADK_COOLDOWN_SECONDS=60
# 自愈白名单（逗号分隔）
VEADK_ALLOWED_SERVICES=frontend,checkoutservice,cartservice,productcatalogservice,paymentservice,shippingservice,currencyservice,emailservice,recommendationservice,adservice,redis-cart,discountservice,telemetryservice,recovery-gateway
